DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional. Defaults: 3306 and mariadb.
DB_PORT=
DB_DIALECT=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# Optional. How long to wait for a connection, and for the per-page claim the update loop
# takes. The claim must stay BELOW the 15s cycle, or half of all cycles skip their own work
# and the bot refreshes every 30s instead of every 15. Redis is not a correctness boundary
# here: an unreachable one degrades to unlocked polling rather than stopping the bot.
# Defaults: 5000, 2000, 12
REDIS_CONNECT_TIMEOUT_MS=
REDIS_LOCK_TIMEOUT_MS=
REDIS_LOCK_TTL_SECONDS=

# Safety (Optional)
# How many subscriptions may be removed in one run of the process before the bot stops
# removing any at all. A channel that answers "unknown channel" is taken as deleted and its
# subscription is dropped — which is also what EVERY channel answers when the bot is holding
# the wrong token for the database it is reading. A handful a day is normal; dozens in one run
# is a symptom, and the right response to a symptom is to stop touching the data.
# Default: 25
SUBSCRIPTION_REAP_LIMIT=
# How long a shutdown may take before the process leaves anyway, in milliseconds. On SIGTERM
# the bot stops scheduling, lets the cycle in flight finish, and closes Discord, the database
# and Redis. Default: 5000
SHUTDOWN_DEADLINE_MS=

# Logging (Optional)
# error | warn | info | debug — default: info
# `debug` logs every statuspage of every cycle; at a few hundred pages that is thousands of
# lines per minute, so keep it off outside of troubleshooting.
LOG_LEVEL=

# Polling behaviour (Optional)
# How long to wait for a status page before giving up, in milliseconds. Must stay well below
# the 15s update interval. Default: 10000
LIVCK_TIMEOUT_MS=
# A status message is only edited when its content changed. This is how often it is refreshed
# anyway, so its timestamp does not look stale on a page that never changes. Default: 15
STATUS_REFRESH_MINUTES=
# How long to wait for the one request that decides whether a URL is a LIVCK page. A user is
# waiting on the /livck subscribe reply, so this is shorter than the poll timeout. Default: 8000
LIVCK_DETECT_TIMEOUT_MS=
# How long one fetched snapshot is reused, so the status handler and the alert handler do not
# ask the same page twice in the same cycle, in milliseconds. Default: 10000
SNAPSHOT_TTL_MS=
# Largest response body accepted from a status page, in bytes. The URL belongs to a customer
# and Node decompresses transparently, so an unbounded body is an out-of-memory kill waiting
# to happen: 199 kB of gzip expands to 200 MB. Default: 8388608 (8 MB)
LIVCK_MAX_BODY_BYTES=
# How long to leave a resolved alert alone between attempts to recover its ending, in
# milliseconds. It fails the "still live" test on every cycle for as long as the reporting
# window lasts, so without a cooldown that is one request every 15 seconds for three days.
# Default: 1800000 (30 minutes)
ALERT_CLOSEOUT_RECHECK_MS=

# Delivery to Discord (Optional)
# How long the bot waits for one channel before moving on without it, in milliseconds. The
# request is not cancelled; the channel is skipped until it comes back, so nothing is posted
# twice. Default: 10000
DISCORD_DELIVERY_TIMEOUT_MS=
# First step of the backoff for a channel that refused the bot, rate limited it or did not
# answer: 1x, 2x, 4x, 10x, 20x this, in milliseconds. Default: 30000 (30s up to 10 minutes)
DELIVERY_BACKOFF_BASE_MS=
# How many channels of one status page are delivered at the same time. Default: 10
DELIVERY_CONCURRENCY=
# Longest wait discord.js may predict from the rate limit headers and sit out by itself, in
# milliseconds. A 429 Discord actually sends is never waited out; see discord/restPolicy.js.
# Default: 30000
DISCORD_MAX_RATE_LIMIT_WAIT_MS=
# How long a cycle waits for one status page before moving on without it, in milliseconds.
# Default: 20000
UPDATE_PAGE_DEADLINE_MS=

# Custom Emojis (Optional - falls back to Unicode emojis if not set)
# Upload emojis from assets/emojis/ to your Discord server and add IDs here
EMOJI_GREEN_DOT=
EMOJI_RED_DOT=
EMOJI_ORANGE_DOT=
EMOJI_BLUE_DOT=

# Crowdin (Optional - only needed for translation management)
CROWDIN_PERSONAL_TOKEN=
